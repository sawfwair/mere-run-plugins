{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mere.run/contracts/archive-investigation.v1.schema.json",
  "title": "mere.run Archive Investigation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "question",
    "piiReductionApplied",
    "model",
    "answer",
    "claims",
    "searches",
    "unresolvedClaims",
    "limits",
    "attempts"
  ],
  "properties": {
    "contractVersion": {
      "const": "mere.run/archive-investigation.v1"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "piiReductionApplied": {
      "const": true
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "unresolved"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "supported"
                }
              }
            },
            "then": {
              "properties": {
                "sources": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "searches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "query",
          "resultPaths"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "resultPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "unresolvedClaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSearches",
        "resultsPerSearch"
      ],
      "properties": {
        "maxSearches": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "resultsPerSearch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsedSeconds",
        "peakProcessTreeRSSBytes",
        "memoryMeasurement",
        "events"
      ],
      "properties": {
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0
        },
        "peakProcessTreeRSSBytes": {
          "type": "integer",
          "minimum": 0
        },
        "memoryMeasurement": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "elapsedSeconds"
            ],
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "elapsedSeconds": {
                "type": "number",
                "minimum": 0
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "inputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "cacheReadTokens": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "type": "integer",
                "minimum": 0
              },
              "requestedOutputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "messageCount": {
                "type": "integer",
                "minimum": 0
              },
              "stopReason": {
                "enum": [
                  "stop",
                  "length",
                  "toolUse",
                  "error",
                  "aborted"
                ]
              },
              "stage": {
                "enum": [
                  "final_response",
                  "claim_contract"
                ]
              },
              "reason": {
                "enum": [
                  "output_limit",
                  "json",
                  "contract_version",
                  "citation"
                ]
              }
            }
          }
        },
        "missedMemorySamples": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
