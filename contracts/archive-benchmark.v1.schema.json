{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mere.run/contracts/archive-benchmark.v1.schema.json",
  "title": "mere.run Archive Benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "createdAt",
    "dataset",
    "source",
    "privacyCanaries",
    "phases",
    "provenance"
  ],
  "properties": {
    "contractVersion": { "const": "mere.run/archive-benchmark.v1" },
    "createdAt": { "type": "string", "format": "date-time" },
    "dataset": {
      "type": "object",
      "required": ["id", "name", "license", "redistribution"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "redistribution": { "type": "string", "minLength": 1 },
        "selectedRows": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "accessDuringIndex"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "accessDuringIndex": { "const": "read-only" }
      }
    },
    "privacyCanaries": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "phases": {
      "type": "object",
      "minProperties": 1,
      "required": ["baseline"],
      "additionalProperties": { "$ref": "#/$defs/phase" }
    },
    "provenance": { "type": "object" },
    "mutations": {
      "type": "array",
      "items": { "$ref": "#/$defs/mutation" }
    }
  },
  "$defs": {
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "document": {
      "type": "object",
      "required": ["id", "paths"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "originalPath": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "relevantDocumentIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "relevantDocumentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "duplicateGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFiles", "documents", "queries", "duplicateGroups", "requireNoFileErrors"],
      "properties": {
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceFile" }
        },
        "documents": {
          "type": "array",
          "items": { "$ref": "#/$defs/document" }
        },
        "queries": {
          "type": "array",
          "items": { "$ref": "#/$defs/query" }
        },
        "duplicateGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/duplicateGroup" }
        },
        "requireNoFileErrors": { "type": "boolean" }
      }
    },
    "mutation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "source", "destination"],
          "properties": {
            "operation": { "const": "move" },
            "source": { "type": "string", "minLength": 1 },
            "destination": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "path", "text"],
          "properties": {
            "operation": { "enum": ["appendText", "writeText"] },
            "path": { "type": "string", "minLength": 1 },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "path"],
          "properties": {
            "operation": { "const": "delete" },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
