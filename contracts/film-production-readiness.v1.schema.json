{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mere.run/contracts/film-production-readiness.v1.schema.json",
  "title": "mere.run Film Production Readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "projectId", "checkedAt", "status", "complete", "productionPlanSha256", "configurationSha256", "models"],
  "properties": {
    "contractVersion": {"const": "mere.run/film-production-readiness.v1"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "checkedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready", "blocked"]},
    "complete": {"type": "boolean"},
    "productionPlanSha256": {"$ref": "#/$defs/sha256"},
    "configurationSha256": {"$ref": "#/$defs/sha256"},
    "models": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "configuredModel", "status"],
        "properties": {
          "role": {"enum": ["imageMaster", "imageShot", "video", "visionInspector", "speechTts", "speechAsr", "sfx", "music"]},
          "configuredModel": {"type": "string", "minLength": 1},
          "resolvedId": {"type": "string", "minLength": 1},
          "manifestSha256": {"$ref": "#/$defs/sha256"},
          "status": {"enum": ["ready", "blocked", "runtime-managed"]},
          "runtime": {"type": "string", "minLength": 1},
          "error": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "ready"}}},
            "then": {"required": ["resolvedId", "manifestSha256"]},
            "else": {
              "if": {"properties": {"status": {"const": "runtime-managed"}}},
              "then": {"required": ["resolvedId", "runtime"]},
              "else": {"required": ["error"]}
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {"properties": {"complete": {"const": true}}},
      "else": {"properties": {"complete": {"const": false}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
