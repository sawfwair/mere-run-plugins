{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mere.run/contracts/plugin-bundle.v1.schema.json",
  "title": "mere.run Installable Plugin Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "package",
    "version",
    "sequence",
    "sourceCommit",
    "platform",
    "minimumOSVersion",
    "expiresAt",
    "appBundle",
    "entrypoints",
    "artifact"
  ],
  "properties": {
    "contractVersion": {
      "const": "mere.run/plugin-bundle.v1"
    },
    "package": {
      "type": "string",
      "pattern": "^mere-[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "platform": {
      "const": "macos-arm64"
    },
    "minimumOSVersion": {
      "const": "15.0"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "appBundle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+\\.app$"
    },
    "entrypoints": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^mere-[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^mere-[a-z0-9-]+$"
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "size"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    }
  }
}
