{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mere.run/contracts/film-take-selection.v1.schema.json",
  "title": "mere.run Film Take Selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "projectId", "createdAt", "sourceDigest", "selector", "summary", "shots"],
  "properties": {
    "contractVersion": {"const": "mere.run/film-take-selection.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "model", "profile"],
      "properties": {
        "command": {"const": "mere.run vision inspect"},
        "model": {"type": "string", "minLength": 1},
        "profile": {"const": "canon-aware-contact-sheet-v1"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shots", "candidates", "selectedForReview"],
      "properties": {
        "shots": {"type": "integer", "minimum": 1},
        "candidates": {"type": "integer", "minimum": 2},
        "selectedForReview": {"type": "integer", "minimum": 0}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shotId", "selectedCandidate", "selectedSeed", "selectedSha256", "decision", "score", "confidence", "candidates"],
        "properties": {
          "shotId": {"type": "string", "minLength": 1},
          "selectedCandidate": {"type": "integer", "minimum": 1, "maximum": 4},
          "selectedSeed": {"type": "integer", "minimum": 0},
          "selectedSha256": {"$ref": "#/$defs/sha256"},
          "decision": {"enum": ["pass", "review"]},
          "score": {"type": "number", "minimum": 0, "maximum": 100},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "candidates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {"$ref": "#/$defs/candidate"}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateIndex", "jobId", "seed", "path", "sha256", "contactSheet", "contactSheetSha256", "decision", "score", "confidence", "observations", "mismatches"],
      "properties": {
        "candidateIndex": {"type": "integer", "minimum": 1, "maximum": 4},
        "jobId": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "contactSheet": {"type": "string", "minLength": 1},
        "contactSheetSha256": {"$ref": "#/$defs/sha256"},
        "decision": {"enum": ["pass", "review"]},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "observations": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
        "mismatches": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "severity", "message"],
            "properties": {
              "code": {"type": "string", "minLength": 1},
              "severity": {"type": "string", "minLength": 1},
              "message": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
