{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mere.run/contracts/frontier-handoff-run.v1.schema.json",
  "title": "mere.run Frontier Handoff Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "runId", "plugin", "status", "createdAt", "updatedAt", "request", "backend", "mode", "outputFormat", "access", "resultPath", "cleanup"],
  "properties": {
    "contractVersion": { "const": "mere.run/frontier-handoff-run.v1" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "plugin": { "const": "mere-frontier-handoff" },
    "status": { "enum": ["planned", "running", "succeeded", "failed", "interrupted"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "backend": { "enum": ["claude", "codex"] },
    "mode": { "enum": ["chat", "agent"] },
    "outputFormat": { "enum": ["text", "json"] },
    "access": { "enum": ["none", "read-only", "workspace-write"] },
    "workspace": { "type": "string" },
    "model": { "type": "string" },
    "resultPath": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "outputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "error": { "type": "string" },
    "cleanup": { "enum": ["not-needed", "recorded"] }
  }
}
