{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mere.run/contracts/film-production-plan.v1.schema.json",
  "title": "mere.run Film Production Plan v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["contractVersion", "projectId", "title", "createdAt", "target", "scorePrompt", "cast", "locations", "shots", "plannedDurationSeconds"],
  "properties": {
    "contractVersion": {"const": "mere.run/film-production-plan.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "target": {"type": "object"},
    "scorePrompt": {"type": "string", "minLength": 1},
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "visual", "wardrobe", "voice"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "name": {"type": "string", "minLength": 1},
          "visual": {"type": "string", "minLength": 1},
          "wardrobe": {"type": "string"},
          "voice": {"type": "string"},
          "seed": {"type": "integer", "minimum": 0}
        }
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "visual", "ambience"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "name": {"type": "string", "minLength": 1},
          "visual": {"type": "string", "minLength": 1},
          "ambience": {"type": "string"}
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "purpose", "framePrompt", "prompt", "durationSeconds", "seed", "characters", "location", "dialogue", "soundEffects", "transition", "status", "take"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "purpose": {"type": "string"},
          "framePrompt": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
          "seed": {"type": "integer", "minimum": 0},
          "characters": {"type": "array", "items": {"type": "string"}},
          "location": {"type": "string"},
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["speaker", "text", "startSeconds", "delivery"],
              "properties": {
                "speaker": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
                "text": {"type": "string", "minLength": 1},
                "startSeconds": {"type": "number", "minimum": 0},
                "delivery": {"type": "string", "minLength": 1}
              }
            }
          },
          "soundEffects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["prompt", "startSeconds", "durationSeconds", "levelDb", "seed"],
              "properties": {
                "prompt": {"type": "string", "minLength": 1},
                "startSeconds": {"type": "number", "minimum": 0},
                "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
                "levelDb": {"type": "number", "minimum": -60, "maximum": 6},
                "seed": {"type": "integer", "minimum": 0}
              }
            }
          },
          "transition": {"enum": ["cut", "fade"]},
          "status": {"type": "string"},
          "take": {"type": "integer", "minimum": 1},
          "selectedCandidate": {"type": "integer", "minimum": 1, "maximum": 4},
          "selectedSeed": {"type": "integer", "minimum": 0}
        }
      }
    },
    "plannedDurationSeconds": {"type": "number", "exclusiveMinimum": 0}
  }
}
